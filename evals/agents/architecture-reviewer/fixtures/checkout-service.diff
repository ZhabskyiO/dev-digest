+import { eq } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import { orders, plans } from '../../db/schema.js';
+
+export class CheckoutRepository {
+  constructor(private readonly db: Db) {}
+
+  async findPlan(planId: string) {
+    const rows = await this.db.select().from(plans).where(eq(plans.id, planId));
+    return rows[0] ?? null;
+  }
+  async findOrder(orderId: string) {
+    const rows = await this.db.select().from(orders).where(eq(orders.id, orderId));
+    return rows[0] ?? null;
+  }
+  async createOrder(input: { customerId: string; planId: string; paymentId: string }) {
+    const [row] = await this.db.insert(orders).values({ ...input, status: 'paid' }).returning();
+    return row!;
+  }
+  async markCancelled(orderId: string) {
+    await this.db.update(orders).set({ status: 'cancelled' }).where(eq(orders.id, orderId));
+  }
+}
+
