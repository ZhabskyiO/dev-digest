+import Stripe from 'stripe';
+
+export class StripeClient {
+  private readonly stripe: Stripe;
+  constructor(secretKey: string) {
+    this.stripe = new Stripe(secretKey);
+  }
+  async charge(customerId: string, amountCents: number): Promise<string> {
+    const intent = await this.stripe.paymentIntents.create({ amount: amountCents, currency: 'usd', customer: customerId });
+    return intent.id;
+  }
+}
+
+export default StripeClient;
diff --git a/server/src/modules/checkout/service.ts b/server/src/modules/checkout/service.ts
new file mode 100644
