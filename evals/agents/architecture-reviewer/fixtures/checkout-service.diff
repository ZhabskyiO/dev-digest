+++ b/server/src/modules/checkout/service.ts
@@ -0,0 +1,27 @@
+import type { FastifyRequest } from 'fastify';
+import { StripeClient } from '../../adapters/payments/stripe.js';
+import type { CheckoutRepository } from './repository.js';
+
+export class CheckoutService {
+  private readonly stripe = new StripeClient(process.env.STRIPE_SECRET_KEY ?? '');
+
+  constructor(private readonly repo: CheckoutRepository) {}
+
+  async checkout(req: FastifyRequest<{ Body: { customerId: string; planId: string } }>): Promise<{ orderId: string }> {
+    const { customerId, planId } = req.body;
+    const plan = await this.repo.findPlan(planId);
+    if (!plan) throw new Error('plan not found');
+    const paymentId = await this.stripe.charge(customerId, plan.priceCents);
+    const order = await this.repo.createOrder({ customerId, planId, paymentId });
+    return { orderId: order.id };
+  }
+
+  async cancel(orderId: string): Promise<void> {
+    const order = await this.repo.findOrder(orderId);
+    if (!order) return;
+    await this.repo.markCancelled(orderId);
+  }
+}
+
+export type { CheckoutRepository };
+
