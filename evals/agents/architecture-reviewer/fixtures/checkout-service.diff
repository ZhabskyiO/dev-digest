+import type { FastifyInstance } from 'fastify';
+import { z } from 'zod';
+import { eq } from 'drizzle-orm';
+import { db } from '../../db/client.js';
+import { orders } from '../../db/schema.js';
+import { container } from '../../platform/container.js';
+
+const CheckoutBody = z.object({ customerId: z.string().min(1), planId: z.string().min(1) });
+
+export async function checkoutRoutes(app: FastifyInstance): Promise<void> {
+  app.post('/checkout', { schema: { body: CheckoutBody } }, async (req, reply) => {
+    const result = await container.checkoutService.checkout(req as never);
+    return reply.code(201).send(result);
+  });
+
+  app.get('/checkout/:orderId', async (req, reply) => {
+    const { orderId } = req.params as { orderId: string };
+    const rows = await db.select().from(orders).where(eq(orders.id, orderId));
+    const order = rows[0];
+    if (!order) return reply.code(404).send({ error: 'not found' });
+    if (order.status === 'cancelled' && order.refundedAt == null) {
+      await db.update(orders).set({ status: 'refund_pending' }).where(eq(orders.id, orderId));
+      order.status = 'refund_pending';
+    }
+    return reply.send(order);
+  });
+}
+
+export default checkoutRoutes;
+
+
