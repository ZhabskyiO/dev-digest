+++ b/server/src/modules/repos/helpers.test.ts
@@ -0,0 +1,12 @@
+import { describe, expect, it } from 'vitest';
+import { parseRepoSlug, slugKey } from './helpers.js';
+
+describe('parseRepoSlug', () => {
+  it('parses owner/name, https and ssh forms', () => {
+    expect(parseRepoSlug('ZhabskyiO/dev-digest')).toEqual({ owner: 'ZhabskyiO', name: 'dev-digest' });
+    expect(parseRepoSlug('https://github.com/ZhabskyiO/dev-digest.git')).toEqual({ owner: 'ZhabskyiO', name: 'dev-digest' });
+    expect(parseRepoSlug('git@github.com:ZhabskyiO/dev-digest.git')).toEqual({ owner: 'ZhabskyiO', name: 'dev-digest' });
+    expect(parseRepoSlug('not a repo')).toBeNull();
+    expect(slugKey({ owner: 'ZhabskyiO', name: 'Dev-Digest' })).toBe('zhabskyio/dev-digest');
+  });
+});
