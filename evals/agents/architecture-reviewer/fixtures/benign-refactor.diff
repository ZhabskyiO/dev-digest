+/** Pure helpers for the repos module — no I/O, no framework types. */
+
+export interface RepoSlug {
+  owner: string;
+  name: string;
+}
+
+/** Accepts "owner/name", a GitHub URL, or an SSH remote and returns the slug, or null. */
+export function parseRepoSlug(input: string): RepoSlug | null {
+  const trimmed = input.trim();
+  const m =
+    trimmed.match(/^([\w.-]+)\/([\w.-]+?)(?:\.git)?$/) ??
+    trimmed.match(/github\.com[/:]([\w.-]+)\/([\w.-]+?)(?:\.git)?\/?$/);
+  if (!m) return null;
+  return { owner: m[1]!, name: m[2]! };
+}
+
+export const slugKey = (s: RepoSlug): string => `${s.owner}/${s.name}`.toLowerCase();
