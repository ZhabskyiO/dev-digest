# @devdigest/api environment
DATABASE_URL=postgres://devdigest:devdigest@localhost:5432/devdigest

# LLM providers (BYO key — entered via Settings UI in prod; env for local dev).
# Optional: the app boots with none. A key is only needed for the provider you
# actually run a review on (or embeddings, see EMBEDDINGS_ENABLED).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub (REST via Octokit) — PAT with repo scope. Canonical name is
# GITHUB_TOKEN; GITHUB_PAT is still accepted as a fallback for back-compat.
GITHUB_TOKEN=

# Memory/RAG embeddings (OpenAI text-embedding-3-small). Default OFF → the app
# makes ZERO OpenAI requests. Set true to enable memory retrieval.
EMBEDDINGS_ENABLED=false

# repo-intel facade (Tier 1: repo skeleton + callers in the review prompt).
# Default ON; set false to degrade every consumer to ripgrep-only behavior.
REPO_INTEL_ENABLED=true

API_PORT=3001
# Interface the API binds to. Loopback by default — the API is unauthenticated,
# so 0.0.0.0 exposes every route to your local network.
API_HOST=127.0.0.1
WEB_PORT=3000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: info, silent in test)
LOG_LEVEL=
DEVDIGEST_CLONE_DIR=./clones

# Project Context (attach specs/docs/insights to a review). All optional —
# every var below defaults sensibly if left blank.
# Discovery roots walked at any depth in the repo clone, comma-separated,
# case-insensitive.
PROJECT_CONTEXT_ROOTS=specs,docs,insights
# Conventional filenames recognised anywhere in the clone regardless of root,
# comma-separated, case-insensitive. Exact basenames, NOT globs — leave empty
# to discover by root alone (**/{specs,docs,insights}/**/*.md).
PROJECT_CONTEXT_FILENAMES=insights.md
# Per-run token budget for the effective (attached) document set; documents
# are injected in order until the budget is reached, the remainder is dropped.
PROJECT_CONTEXT_BUDGET_TOKENS=12000
# Per-document character cap applied before injection into a run's prompt.
PROJECT_CONTEXT_DOC_CHAR_CAP=16000
# Discovery cap on the number of documents returned per scan.
PROJECT_CONTEXT_MAX_DOCS=500
# Discovery cap on a single file's size in bytes; larger files are omitted.
PROJECT_CONTEXT_MAX_FILE_BYTES=1048576
# Character cap applied when rendering a document preview in the UI.
PROJECT_CONTEXT_PREVIEW_CHARS=16000

# Onboarding tour generation — the single structured model call that builds a
# repo's onboarding tour. All optional — every var below defaults sensibly if
# left blank.
# Token budget for the assembled generation prompt (repo skeleton + excerpts +
# endpoint facts, etc.).
ONBOARDING_PROMPT_TOKEN_BUDGET=28000
# Per-file character cap applied to a key-file excerpt before injection.
ONBOARDING_EXCERPT_CHAR_CAP=4000
# Max number of key-file excerpts included in the generation prompt.
ONBOARDING_MAX_EXCERPT_FILES=10
# Max number of endpoint facts (from repo-intel) included in the prompt.
ONBOARDING_MAX_ENDPOINT_FACTS=200
# Minimum grounded items a section needs after dropping ungrounded ones;
# below this the section is stored empty with an `insufficient_grounding`
# reason instead of being backfilled.
ONBOARDING_MIN_SECTION_ITEMS=1
# Max number of critical-path entries in the generated tour.
ONBOARDING_MAX_CRITICAL_PATHS=8
# Max number of command attestations (from package.json scripts, etc.).
ONBOARDING_MAX_COMMANDS=12
# Max number of entries in the suggested reading path.
ONBOARDING_MAX_READING_PATH=7
# Max number of suggested first tasks.
ONBOARDING_MAX_FIRST_TASKS=5
# Max number of frontend routes listed in the tour.
ONBOARDING_MAX_FRONTEND_ROUTES=12
# Max number of API endpoints listed in the tour.
ONBOARDING_MAX_API_ENDPOINTS=24
# Timeout (ms) for the structured generation model call. Kept comfortably
# below JobRunner's own 120000ms job timeout — a generation allowed to run
# longer than the job would be aborted by JobRunner and then retried.
ONBOARDING_GENERATION_TIMEOUT_MS=90000
# Language the generated onboarding tour is written in.
ONBOARDING_LANGUAGE=English
