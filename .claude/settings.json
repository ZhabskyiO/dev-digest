{
  "permissions": {
    "allow": [
      "Bash(${CLAUDE_PROJECT_DIR}/.claude/skills/engineering-insights/scripts/list-entries.sh:*)",
      "Bash(.claude/skills/engineering-insights/scripts/list-entries.sh:*)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Skill(engineering-insights)",
      "Skill(engineering-insights:*)",
      "Bash(awk '{print \"  +\"$1\" -\"$2\"  \"$3}')",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/engineering-insights/scripts/list-entries.sh\" 2>/dev/null | jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:(\"Insights already recorded in this repo. Read the relevant module insights/ folder before working; never re-record anything listed here.\\n\"+.)}}' || true",
            "timeout": 10,
            "statusMessage": "Loading recorded insights…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/skills/pr-self-review/scripts/check-gate.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  }
}
